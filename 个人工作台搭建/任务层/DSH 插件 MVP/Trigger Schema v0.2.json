{
  "title": "Personal Workspace Trigger · MVP 实验版",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "type",
    "intent",
    "context",
    "status",
    "source",
    "target"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "type": {
      "enum": [
        "action",
        "knowledge",
        "undecided"
      ]
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1400
    },
    "context": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1400
    },
    "status": {
      "enum": [
        "candidate",
        "clarifying",
        "accepted",
        "dismissed"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversation_id",
        "message_ids"
      ],
      "properties": {
        "conversation_id": {
          "type": "string",
          "minLength": 1
        },
        "message_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "target": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "enum": [
                "task",
                "milestone"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "accepted"
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "target": {
            "type": "null"
          }
        }
      }
    }
  ]
}
